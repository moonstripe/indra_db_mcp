{
  "name": "indra_db_mcp",
  "version": "0.1.0",
  "description": "MCP server for indra_db - a content-addressed graph database for versioned thoughts",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "indra-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indra_db",
    "knowledge-graph",
    "vector-database",
    "versioned-thoughts"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
