{
  "name": "indra_db_mcp",
  "version": "0.1.26",
  "description": "MCP server for indra_db - a content-addressed graph database for versioned thoughts",
  "type": "module",
  "bin": {
    "indra-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indra_db",
    "knowledge-graph",
    "vector-database",
    "versioned-thoughts",
    "ai-memory",
    "semantic-search",
    "graph-database"
  ],
  "author": "moonstripe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstripe/indra_db_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/moonstripe/indra_db_mcp/issues"
  },
  "homepage": "https://github.com/moonstripe/indra_db_mcp#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "files": [
    "src",
    "README.md"
  ]
}
